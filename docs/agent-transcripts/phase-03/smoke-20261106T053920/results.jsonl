gest':sha256(json.dumps(sessions,default=str).encode()).hexdigest()},default=str))\nengine.dispose()\n"], "exit_code": 0, "stdout": "{\"active_chunks\": 114, \"active_ids_digest\": \"f2d8337b05e90fdc9e057814ac38acc73b8a6193cd374c89f8365832d16007e6\", \"source_hashes_match\": true, \"spans_vectors_fulltext_valid\": true, \"max_active_versions_per_episode\": 1, \"active_sources\": [{\"source_path\": \"episodes/ada-chen-rekhi/transcript.md\", \"source_hash\": \"1240fdbe55f70fd2047feb2eed58a9c4f700fde689bd4c9d2385a07123c62185\", \"current_version\": 1, \"corpus_revision\": \"be8ab89a890a833cbba2c892178f823fff178c65\"}, {\"source_path\": \"episodes/adam-fishman/transcript.md\", \"source_hash\": \"56e7d7e7b85d35974b033b6a20432e00a5aef198db40bee72268ef9238d75c74\", \"current_version\": 1, \"corpus_revision\": \"be8ab89a890a833cbba2c892178f823fff178c65\"}, {\"source_path\": \"episodes/adam-grenier/transcript.md\", \"source_hash\": \"2989e256c95030ad6b7634b16317e65564da1a2fd0154bc911f00129a8f18213\", \"current_version\": 1, \"corpus_revision\": \"be8ab89a890a833cbba2c892178f823fff178c65\"}], \"message_count\": 6, \"message_digest\": \"85bac40d62cc4e214eb3ef4ba8d8d3b09b546b143bd19cdc09d41d25c14b3f02\", \"session_digest\": \"7404c0e197945a1fdf57d84df6e7ee6522fea1f47a8789a79fc5e9e2712637b4\"}\n", "stderr": ""}
