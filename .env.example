# Local evaluation only. bootstrap.py generates an ignored .env with a random password.
# Required: never use this placeholder as a real credential.
POSTGRES_PASSWORD=replace-with-generated-local-password
# Optional local defaults; existing host PostgreSQL on 5432 is left untouched.
POSTGRES_USER=lenny
POSTGRES_DB=lenny
DB_HOST_PORT=55432
API_HOST_PORT=8000
WEB_HOST_PORT=8080
OLLAMA_URL=http://host.docker.internal:11434
GENERATION_MODEL=qwen3:0.6b
EMBEDDING_MODEL=nomic-embed-text:latest
DEFAULT_PROVIDER=ollama
# Optional credential presence is reported, but cloud inference is not implemented yet.
ANTHROPIC_API_KEY=
