# Local Ollama is default; cloud inference requires explicit DEFAULT_PROVIDER=openrouter or anthropic. bootstrap.py generates an ignored .env with a random password.
# Required: never use this placeholder as a real credential.
POSTGRES_PASSWORD=replace-with-generated-local-password
# Optional local defaults; existing host PostgreSQL on 5432 is left untouched.
POSTGRES_USER=lenny
POSTGRES_DB=lenny
DB_HOST_PORT=55432
API_HOST_PORT=8000
WEB_HOST_PORT=8080
OLLAMA_URL=http://host.docker.internal:11434
GENERATION_MODEL=qwen3:0.6b
EMBEDDING_MODEL=nomic-embed-text:latest
DEFAULT_PROVIDER=ollama
# Optional cloud key stays server-side; no implicit switch or automatic fallback.
ANTHROPIC_API_KEY=

# Essay-only local model; chat remains GENERATION_MODEL.
ESSAY_MODEL=qwen3:1.7b

# Used for chat/essay only when DEFAULT_PROVIDER=anthropic; local embedding is retained.
CLOUD_MODEL=claude-haiku-4-5-20251001

# Opt-in sensitive Pi stdout/stderr in private local volume; never publish/upload.
PRIVATE_RPC_TRACES=false

# OpenRouter through Pi: explicitly select DEFAULT_PROVIDER=openrouter.
# Put the real key only in your ignored local .env; never in this example.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
